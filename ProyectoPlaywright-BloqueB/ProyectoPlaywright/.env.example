# URL base donde corre la aplicación ASP.NET Core (Bloque A)
# Debe coincidir con Properties/launchSettings.json del proyecto web
BASE_URL=http://localhost:5180

# Ruta al archivo Excel con los datos de prueba
EXCEL_FILE_PATH=./data/registros.xlsx

# Ruta a la imagen de ejemplo usada para el campo de Avatar (File Upload)
SAMPLE_IMAGE_PATH=./data/images/avatar-sample.png

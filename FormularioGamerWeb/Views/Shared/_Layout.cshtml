<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Centro de Reclutamiento</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@@500;700;900&family=Rajdhani:wght@@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="scanlines" aria-hidden="true"></div>

    <header class="hud-header">
        <div class="hud-header__inner">
            <a class="hud-logo" asp-controller="Registro" asp-action="Index">
                <span class="hud-logo__bracket">[</span>
                <span class="hud-logo__text">CENTRO&nbsp;DE&nbsp;RECLUTAMIENTO</span>
                <span class="hud-logo__bracket">]</span>
            </a>
            <nav class="hud-nav">
                <a asp-controller="Registro" asp-action="Index">Nuevo Registro</a>
                <a asp-controller="Registro" asp-action="Lista">Jugadores Registrados</a>
            </nav>
        </div>
    </header>

    <main class="hud-main">
        @RenderBody()
    </main>

    <footer class="hud-footer">
        <p>Sistema de Registro &mdash; Proyecto educativo ASP.NET Core MVC + SQL Server</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
